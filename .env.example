# App
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-random-string

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tender_pipeline
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379/0

# LLM (OpenAI-совместимый)
LLM_API_KEY=sk-...
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_CHAT=gpt-4o-mini
LLM_MODEL_EMBEDDING=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536

# Google Search
GOOGLE_SEARCH_API_KEY=...
GOOGLE_SEARCH_CX=...
GOOGLE_SEARCH_MAX_RESULTS=10

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=robot@company.ru
SMTP_PASSWORD=...
SMTP_USE_TLS=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=robot@company.ru
IMAP_PASSWORD=...

# Files
UPLOAD_DIR=/app/uploads

# Telegram
TELEGRAM_BOT_TOKEN=...

# S3/MinIO (опционально)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tender-files
S3_USE_SSL=false

# Encryption
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Tender source (ГосПлан)
TENDER_SOURCE_API_URL=https://v2test.gosplan.info/fz44/purchases
